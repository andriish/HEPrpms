+            IQ(LTMP1+JTMP+3) = IOFFSTV(1)
+#else
             IQ(LTMP1+JTMP+3) = IOFFSTV(2)
+#endif
 #endif
          ELSE
             IQ(LTMP1+JTMP+2) = 0
